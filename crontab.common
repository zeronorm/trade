# crontab 公共配置 — 不单独使用，和平台文件合并
# 用法: cat crontab.common crontab.example | crontab -

SHELL=/bin/bash
PROJECT_DIR=~/YUGH/dev/trade
CONDA_BIN=~/miniconda3/bin
CONDA_ENV=dev
LOG_DIR=${PROJECT_DIR}/logs/cron

# 默认启用断点续跑 + 单票轻量重试
SYNC="mkdir -p ${LOG_DIR} && source ${CONDA_BIN}/activate ${CONDA_ENV} && cd ${PROJECT_DIR} && python scripts/sync_market_data.py --hist-retries 2 --hist-retry-delay 1"
