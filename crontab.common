# crontab 公共配置 — 不单独使用，和平台文件合并
# 推荐使用: scripts/init_crontab.sh ecs 或 scripts/init_crontab.sh mac

SHELL=/bin/bash
PROJECT_DIR=~/YUGH/dev/trade
CONDA_BIN=~/miniconda3/bin
CONDA_ENV=dev
LOG_DIR=${PROJECT_DIR}/logs/cron
REMOTE_HOST=ecs
REMOTE_PROJECT_DIR=/root/dev/trade

# crontab 只保留薄入口；run/skip、锁、日志、sync、merge 都在脚本里。
PIPELINE=${PROJECT_DIR}/scripts/pipline.sh
