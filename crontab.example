# crontab.example — Ubuntu
# 合并使用: cat crontab.common crontab.example | crontab -

# A股  收盘15:00 → 15:30
30 15 * * 1-5  /bin/bash -c '${SYNC} --market cn >> ${LOG_DIR}/cn.log 2>&1'

# 港股  收盘16:00 → 16:30
30 16 * * 1-5  /bin/bash -c '${SYNC} --market hk >> ${LOG_DIR}/hk.log 2>&1'

# 美股  收盘16:00 ET → 04:30 CST 次日
30 4  * * 2-6  /bin/bash -c '${SYNC} --market us >> ${LOG_DIR}/us.log 2>&1'
