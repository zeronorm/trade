SHELL=/bin/bash

PROJECT_DIR=/Users/yugh/YUGH/dev/trade
CONDA_BIN=/Users/yugh/miniconda3/bin/conda
CONDA_ENV=dev
LOG_DIR=${PROJECT_DIR}/logs

# unified market_data sync
40 16 * * 1-5 cd ${PROJECT_DIR} && ${CONDA_BIN} run -n ${CONDA_ENV} python ${PROJECT_DIR}/scripts/sync_market_data.py --market cn --continue-on-error >> ${LOG_DIR}/market_cn.log 2>&1
40 17 * * 1-5 cd ${PROJECT_DIR} && ${CONDA_BIN} run -n ${CONDA_ENV} python ${PROJECT_DIR}/scripts/sync_market_data.py --market hk --continue-on-error >> ${LOG_DIR}/market_hk.log 2>&1
40 08 * * 2-6 cd ${PROJECT_DIR} && ${CONDA_BIN} run -n ${CONDA_ENV} python ${PROJECT_DIR}/scripts/sync_market_data.py --market us --continue-on-error >> ${LOG_DIR}/market_us.log 2>&1
