# crontab.example.mac — macOS
# 推荐使用: scripts/init_crontab.sh mac

# 说明:
# - 本机只负责从 ecs 同步数据并重建本地 merge
# - crontab 不放复杂逻辑；锁、run/skip 和日志统一由 scripts/pipline.sh 处理

# A股：从 16:00 到 23:30 每 30 分钟同步并 merge
0 16 * * 1-5  ${PIPELINE} mac cn
*/30 17-23 * * 1-5  ${PIPELINE} mac cn

# 港股：从 17:00 到 23:30 每 30 分钟同步并 merge
0 17 * * 1-5  ${PIPELINE} mac hk
*/30 18-23 * * 1-5  ${PIPELINE} mac hk

# 美股：从 06:00 到 12:30(Asia/Shanghai) 每 30 分钟同步并 merge
0 6 * * 2-6  ${PIPELINE} mac us
*/30 7-12 * * 2-6  ${PIPELINE} mac us
